{
  "version": "0.2",
  "name": "admin-console",
  "pages": {
    "dashboard": {
      "name": "DashboardPage",
      "size": {
        "width": 1440,
        "height": 900
      },
      "root": "root",
      "nodes": {
        "root": {
          "type": "frame",
          "name": "DashboardPage",
          "box": {
            "width": "fill",
            "height": "fill"
          },
          "layout": {
            "direction": "column",
            "gap": 24,
            "padding": {
              "top": 32,

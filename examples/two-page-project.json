          "content": "계정 정보를 입력하세요",
          "color": "#666666",
          "typography": {
            "fontFamily": "Pretendard",
            "fontSize": 14,
            "fontWeight": 400,
            "lineHeight": 20,
            "letterSpacing": 0,
            "textAlign": "center"
          }

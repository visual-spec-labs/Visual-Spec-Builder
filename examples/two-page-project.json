              "bottom": 32,
              "left": 32
            },
            "mainAxis": "start",
            "crossAxis": "stretch"
          },
          "background": {
            "color": "#F7F8FA"
          },
          "children": [
            {
              "node": "header"
            },
            {
              "node": "content"
            }
          ]
        },
        "header": {
          "type": "frame",
          "name": "Header",
          "box": {
            "width": "fill",
            "height": "auto"

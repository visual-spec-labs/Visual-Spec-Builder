            "fontWeight": 500,
            "lineHeight": 18,
            "letterSpacing": 0,
            "textAlign": "left"
          }
        },
        "cardBValue": {
          "type": "text",
          "name": "Value",
          "box": {
            "width": "auto",
            "height": "auto"
          },
          "content": "3.7%",
          "color": "#111111",
          "typography": {
            "fontFamily": "Pretendard",
            "fontSize": 28,
            "fontWeight": 700,
            "lineHeight": 36,
            "letterSpacing": -0.4,
            "textAlign": "left"
          }
        }
      }
    },
    "login": {
      "name": "Login",
      "size": {
        "width": 390,
        "height": 844
      },
      "root": "root",
      "nodes": {
        "root": {
          "type": "frame",
          "name": "Screen",
          "box": {
            "width": "fill",
            "height": "fill"
          },
          "layout": {
            "direction": "column",
            "gap": 16,
            "padding": {
              "top": 24,
              "right": 20,
              "bottom": 24,
              "left": 20

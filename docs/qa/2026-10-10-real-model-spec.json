          "background": [
            {
              "type": "solid",
              "color": "#FFFFFF"
            }
          ],
          "children": [
            {
              "node": "hero"
            },
            {
              "node": "content"
            }
          ]
        },
        "hero": {
          "type": "image",
          "name": "Hero",
          "box": {
            "width": "fill",
            "height": 200
          },
          "src": "assets/hero.png",
          "fit": "cover"

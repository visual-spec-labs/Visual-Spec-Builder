          "color": "#111111",
          "typography": {
            "fontFamily": "Pretendard",
            "fontSize": 24,
            "fontWeight": 700,
            "lineHeight": 32,
            "letterSpacing": -0.5,
            "textAlign": "left"
          }
        },
        "emailInput": {
          "type": "input",
          "name": "EmailInput",
          "box": {
            "width": "fill",
            "height": 44

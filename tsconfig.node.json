{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/features/editor/schema",
    "test",
    "scripts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  // 브라우저 모듈을 직접 부르는 테스트는 DOM 타입이 필요해 tsconfig.uitest.json이
  // 맡는다. 한 파일이 두 프로젝트에 겹쳐 들어가지 않도록 여기서 뺀다.
  // ticket-runner.test.ts는 ui/ticketRunner.ts를 거쳐 ticketAgentClient.ts(fetch)를
  // 끌어들인다(이슈 #184) — 같은 이유로 뺀다.
  "exclude": ["test/persistence-status.test.ts", "test/unnamed-drafts.test.ts", "test/rename-project.test.ts", "test/spec-autosave.test.ts", "test/document-path.test.ts", "test/ticket-runner.test.ts", "test/home-projects.test.ts", "test/workspace-list-metadata.test.ts", "test/open-conflict.test.ts", "test/image-asset-import.test.ts", "test/export-generated-code.test.ts", "test/reopen-draft.test.ts", "test/agent-request-lock.test.ts", "test/panel-handoff.test.ts", "test/agent-edit-bridge.test.ts", "test/agent-edit-recovery.test.ts", "test/disk-watch.test.ts", "test/disk-watch-transport.test.ts", "test/panel-toggle.test.ts", "test/preview-thumbnail.test.ts", "test/editing-context-render.test.ts", "test/ticket-agent-client.test.ts", "test/ticket-output-acceptance.test.ts", "test/manual-change-guard.test.ts", "test/generation-ownership.test.ts"]
}

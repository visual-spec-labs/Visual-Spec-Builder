    "ButtonOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "visible": {
          "type": "boolean",
          "default": true
        },
        "box": {
          "$ref": "#/$defs/PartialBox"
        },
        "typography": {
          "$ref": "#/$defs/PartialTypography"
        },
        "color": {
          "$ref": "#/$defs/Color"
        },
        "background": {
          "$ref": "#/$defs/Background"
        },
        "border": {
          "$ref": "#/$defs/PartialBorder"
        }
      }
    },
    "InputOverride": {
      "type": "object",
      "additionalProperties": false,
